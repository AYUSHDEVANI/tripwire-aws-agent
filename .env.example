# Tripwire Environment Configuration
# Copy this file to .env and configure for your local or AWS environment.
# MOCK MODE runs fully locally with zero AWS charges or credentials required!

# Operating Mode: "mock" (default, zero cost) or "live"
TRIPWIRE_MODE=mock

# AWS Bedrock Configuration (Used for Main Agent & Escalation Judge in live mode)
AWS_REGION=us-east-1
AWS_PROFILE=default
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_JUDGE_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Strands Decider 2B Endpoint
# Start the local server with: strands-decider serve
DECIDER_ENDPOINT=http://localhost:8099
DECIDER_TIMEOUT_SECONDS=2.0
DECIDER_MOCK_FALLBACK=true

# Decision Cascade Confidence Thresholds (PRD Tuned)
CASCADE_ALLOW_THRESHOLD=0.85
CASCADE_ASK_THRESHOLD=0.60
CASCADE_STRICT_DESTRUCTIVE=true

# Security & Authorization
TRIPWIRE_CALLER_ROLE=operator
TRIPWIRE_ALLOW_PROD_MUTATIONS=false

# Audit Logging & Storage
TRIPWIRE_AUDIT_PATH=./data/audit.jsonl
TRIPWIRE_LOG_LEVEL=INFO
